rules_version = '2';

// Everything not listed here is denied by default.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------

    function signedIn() {
      return request.auth != null;
    }

    // Email/password users must have opened the verification link first.
    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return verified() && request.auth.uid == uid;
    }

    function validText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function validYear(value) {
      return value is int && value >= 1950 && value <= 2100;
    }

    // End year may be null (still ongoing) but never before the start year.
    function validEndYear(d) {
      return d.endYear == null
        || (validYear(d.endYear) && d.endYear >= d.startYear);
    }

    // ---------- users: only the owner can read or write ----------

    function validProfile(d) {
      return d.keys().hasAll(['fullName', 'email', 'onboardingComplete'])
        && validText(d.fullName, 2, 60)
        && validText(d.email, 3, 254)
        && d.email.lower() == request.auth.token.email.lower()
        && d.onboardingComplete is bool
        && (!('phone' in d) || validText(d.phone, 0, 25))
        && (!('location' in d) || validText(d.location, 0, 60));
    }

    function validEducation(d) {
      return d.keys().hasAll(['school', 'degree', 'startYear', 'endYear'])
        && validText(d.school, 2, 80)
        && validText(d.degree, 2, 80)
        && validYear(d.startYear)
        && validEndYear(d)
        && (!('fieldOfStudy' in d) || validText(d.fieldOfStudy, 0, 80));
    }

    function validExperience(d) {
      return d.keys().hasAll(['company', 'role', 'startYear', 'endYear'])
        && validText(d.company, 2, 80)
        && validText(d.role, 2, 80)
        && validYear(d.startYear)
        && validEndYear(d)
        && (!('description' in d) || validText(d.description, 0, 500));
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validProfile(request.resource.data);
      allow delete: if false;

      match /education/{itemId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && validEducation(request.resource.data);
      }

      match /experience/{itemId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && validExperience(request.resource.data);
      }
    }

    // ---------- jobs: everyone signed in reads published jobs ----------

    match /jobs/{jobId} {
      allow get: if verified()
        && (resource == null
          || resource.data.status == 'published'
          || resource.data.employerId == request.auth.uid);
      allow list: if verified()
        && (resource.data.status == 'published'
          || resource.data.employerId == request.auth.uid);

      // Only the employer who owns a job can create, change or delete it.
      allow create: if verified()
        && request.resource.data.employerId == request.auth.uid;
      allow update, delete: if verified()
        && resource.data.employerId == request.auth.uid;
    }

    // ---------- applications: only the applicant and the employer ----------

    function isParty(d) {
      return d.applicantId == request.auth.uid
        || d.employerId == request.auth.uid;
    }

    match /applications/{applicationId} {
      allow get: if verified() && (resource == null || isParty(resource.data));
      allow list: if verified() && isParty(resource.data);

      // An applicant creates their own application for a real job, and the
      // employer on it must be the job's real owner.
      allow create: if verified()
        && request.resource.data.applicantId == request.auth.uid
        && applicationId ==
          request.resource.data.jobId + '_' + request.auth.uid
        && request.resource.data.status == 'submitted'
        && request.resource.data.coverLetter.size() <= 1000
        && get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId))
          .data.employerId == request.resource.data.employerId;

      // Only the employer changes the status, and nothing else.
      allow update: if verified()
        && resource.data.employerId == request.auth.uid
        && resource.data.status in ['submitted', 'underReview']
        && request.resource.data.status in ['underReview', 'accepted', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt']);

      // The applicant can withdraw until a decision is made.
      allow delete: if verified()
        && resource.data.applicantId == request.auth.uid
        && resource.data.status in ['submitted', 'underReview'];
    }
  }
}
