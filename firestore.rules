rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn()
        && request.auth.token.email_verified == true;
    }

    function uid() {
      return request.auth.uid;
    }

    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function role() {
      return exists(userPath(uid()))
        ? get(userPath(uid())).data.get('role', 'seeker')
        : 'seeker';
    }

    function isAdmin() {
      return signedIn() && role() == 'admin';
    }

    function isEmployer() {
      return signedIn() && role() == 'employer';
    }

    function isOwner(userId) {
      return verified() && uid() == userId;
    }

    function validText(value, min, max) {
      return value is string
        && value.size() >= min
        && value.size() <= max;
    }

    function validYear(value) {
      return value is int && value >= 1950 && value <= 2100;
    }

    function validEndYear(data) {
      return data.endYear == null
        || (
          validYear(data.endYear)
          && data.endYear >= data.startYear
        );
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function validProfile(data) {
      return data.keys().hasAll([
          'fullName',
          'email',
          'onboardingComplete'
        ])
        && validText(data.fullName, 2, 60)
        && validText(data.email, 3, 254)
        && data.email.lower() == request.auth.token.email.lower()
        && data.onboardingComplete is bool
        && (!('phone' in data) || validText(data.phone, 0, 25))
        && (!('location' in data) || validText(data.location, 0, 60));
    }

    function validEducation(data) {
      return data.keys().hasAll([
          'school',
          'degree',
          'startYear',
          'endYear'
        ])
        && validText(data.school, 2, 80)
        && validText(data.degree, 2, 80)
        && validYear(data.startYear)
        && validEndYear(data)
        && (
          !('fieldOfStudy' in data)
          || validText(data.fieldOfStudy, 0, 80)
        );
    }

    function validExperience(data) {
      return data.keys().hasAll([
          'company',
          'role',
          'startYear',
          'endYear'
        ])
        && validText(data.company, 2, 80)
        && validText(data.role, 2, 80)
        && validYear(data.startYear)
        && validEndYear(data)
        && (
          !('description' in data)
          || validText(data.description, 0, 500)
        );
    }

    // ---------- User profiles ----------

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId)
        && validProfile(request.resource.data)
        && request.resource.data.get('role', 'seeker')
          in ['seeker', 'employer'];

      allow update: if isAdmin()
        || (
          isOwner(userId)
          && validProfile(request.resource.data)
          && !changedKeys().hasAny(['role'])
        );

      allow delete: if isAdmin();

      match /education/{itemId} {
        allow read, delete: if isOwner(userId);

        allow create, update: if isOwner(userId)
          && validEducation(request.resource.data);
      }

      match /experience/{itemId} {
        allow read, delete: if isOwner(userId);

        allow create, update: if isOwner(userId)
          && validExperience(request.resource.data);
      }
    }

    // ---------- Jobs ----------

    match /jobs/{jobId} {
      allow get: if verified()
        && (
          resource == null
          || resource.data.status == 'published'
          || resource.data.employerId == uid()
          || isAdmin()
        );

      allow list: if verified()
        && (
          resource.data.status == 'published'
          || resource.data.employerId == uid()
          || isAdmin()
        );

      allow create: if verified()
        && (
          isAdmin()
          || (
            isEmployer()
            && request.resource.data.employerId == uid()
            && request.resource.data.get('isVerified', false) == false
          )
        );

      allow update: if verified()
        && (
          isAdmin()
          || (
            isEmployer()
            && resource.data.employerId == uid()
            && !changedKeys().hasAny(['employerId', 'isVerified'])
          )
        );

      allow delete: if verified()
        && (
          isAdmin()
          || (
            isEmployer()
            && resource.data.employerId == uid()
          )
        );
    }

    // ---------- Job applications ----------

    match /applications/{applicationId} {
      allow get: if verified()
        && (
          applicationId.matches('^.+_' + uid() + '$')
          || (
            resource != null
            && (
              resource.data.applicantId == uid()
              || resource.data.employerId == uid()
              || isAdmin()
            )
          )
        );

      allow list: if verified()
        && (
          resource.data.applicantId == uid()
          || resource.data.employerId == uid()
          || isAdmin()
        );

      allow create: if verified()
        && request.resource.data.applicantId == uid()
        && applicationId
          == request.resource.data.jobId + '_' + uid()
        && request.resource.data.status == 'submitted'
        && request.resource.data.keys().hasOnly([
          'jobId',
          'applicantId',
          'employerId',
          'status',
          'appliedAt',
          'updatedAt',
          'coverLetter',
          'jobTitle',
          'employerName'
        ])
        && request.resource.data.coverLetter is string
        && request.resource.data.coverLetter.size() <= 1000
        && exists(
          /databases/$(database)/documents/jobs/$(request.resource.data.jobId)
        )
        && get(
          /databases/$(database)/documents/jobs/$(request.resource.data.jobId)
        ).data.status == 'published'
        && get(
          /databases/$(database)/documents/jobs/$(request.resource.data.jobId)
        ).data.employerId == request.resource.data.employerId;

      allow update: if verified()
        && (
          isAdmin()
          || resource.data.employerId == uid()
        )
        && changedKeys().hasOnly(['status', 'updatedAt'])
        && resource.data.status in ['submitted', 'underReview']
        && request.resource.data.status in [
          'underReview',
          'accepted',
          'rejected'
        ]
        && request.resource.data.status != resource.data.status;

      allow delete: if verified()
        && resource.data.applicantId == uid()
        && resource.data.status in ['submitted', 'underReview'];
    }
  }
}